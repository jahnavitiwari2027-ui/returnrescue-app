# ───── Browser-visible (safe to expose) ─────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Plans and prices live in src/lib/plans.ts (keep them in sync with the Dodo products).
# "test" shows test-card hints on the billing page; "live" hides them.
# VITE_LIVE_PAYMENTS_MODE, if set, takes priority.
VITE_PAYMENTS_MODE=test
# Optional public contact email shown on the site
VITE_CONTACT_EMAIL=

# ───── Server-only secrets (Netlify env vars, NEVER commit) ─────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# AI provider: Google Gemini (free tier) is used when GEMINI_API_KEY is set.
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative (paid): Anthropic Claude. Force a provider with AI_PROVIDER=gemini|anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
DODO_PAYMENTS_API_KEY=your-dodo-test-api-key
DODO_PAYMENTS_WEBHOOK_KEY=your-dodo-webhook-secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
# One Dodo product per plan and billing period
DODO_STARTER_MONTHLY_PRODUCT_ID=pdt_...
DODO_STARTER_YEARLY_PRODUCT_ID=pdt_...
DODO_PRO_PRODUCT_ID=pdt_...
DODO_PRO_YEARLY_PRODUCT_ID=pdt_...
# Live settings can be added as DODO_LIVE_API_KEY, DODO_LIVE_WEBHOOK_KEY, DODO_LIVE_ENVIRONMENT
# and DODO_LIVE_PRO_PRODUCT_ID; these take priority over the names above.
# Public site URL used for checkout return links (defaults to Netlify's URL)
SITE_URL=https://your-domain.com
