# ───── Browser-visible (safe to expose) ─────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Price shown on the site (keep in sync with the Dodo product price)
VITE_PRO_PRICE_INR=999
# "test" shows test-card hints on the billing page; set to "live" when live
VITE_PAYMENTS_MODE=test
# Optional public contact email shown on the site
VITE_CONTACT_EMAIL=

# ───── Server-only secrets (Netlify env vars, NEVER commit) ─────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# AI provider: Google Gemini (free tier) is used when GEMINI_API_KEY is set.
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative (paid): Anthropic Claude. Force a provider with AI_PROVIDER=gemini|anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
DODO_PAYMENTS_API_KEY=your-dodo-test-api-key
DODO_PAYMENTS_WEBHOOK_KEY=your-dodo-webhook-secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRO_PRODUCT_ID=pdt_...
# Public site URL used for checkout return links (defaults to Netlify's URL)
SITE_URL=https://your-domain.com
