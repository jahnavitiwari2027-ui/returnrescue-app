{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["functions/**/*.mts", "functions/**/*.ts", "../src/lib/**/*.ts"],
  "exclude": ["../src/lib/**/*.test.ts", "../src/lib/supabase.ts", "../src/lib/api.ts", "../src/lib/image.ts"]
}
